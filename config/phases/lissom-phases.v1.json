            "RIGHT_ANKLE",
            "RIGHT_HEEL",
            "MID_SHOULDER"
          ]
        },
        {
          "id": "descending",
          "enter": {
            "kind": "delta",
            "metric": "knee_flexion_right",
            "op": "<",
            "valuePerSecond": -30.0
          },
          "timeoutMs": 10000,
          "timeoutCode": "MOVEMENT_NOT_DETECTED",
          "abort": {
            "kind": "confidence",
            "op": "<",
            "value": 0.6
          },
          "abortCode": "LOW_CONFIDENCE"
        },
        {
          "id": "bottom",
          "enter": {
            "kind": "delta",
            "metric": "knee_flexion_right",
            "op": ">",
            "valuePerSecond": -15.0
          },
          "minDurationMs": 1000,
          "timeoutMs": 8000,
          "timeoutCode": "HOLD_TIMEOUT_MEASURED",
          "measureHere": true,
          "abort": {
            "kind": "metric",
            "metric": "heel_rise_right",
            "op": ">",
            "value": 0.05
          },
          "abortCode": "HEEL_LIFT"
        },
        {
          "id": "ascending",
          "enter": {
            "kind": "delta",
            "metric": "knee_flexion_right",
            "op": ">",
            "valuePerSecond": 30.0
          },
          "timeoutMs": 10000,
          "timeoutCode": "RETURN_TIMEOUT"
        },
        {
          "id": "complete",
          "enter": {
            "kind": "metric",
            "metric": "knee_flexion_right",
            "op": ">",
            "value": 155
          },
          "isTerminal": true
        }
      ]
    },
    {
      "testId": "plank_hold",
      "pattern": "timed_hold",
      "perSide": false,
      "phases": [
        {
          "id": "ready",
          "enter": {
            "kind": "metric",
            "metric": "plank_hip_deviation",
            "op": "<",
            "value": 0.22
