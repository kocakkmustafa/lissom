          "timeoutCode": "SETUP_TIMEOUT",
          "requiredLandmarks": [
            "MID_SHOULDER",
            "MID_HIP",
            "RIGHT_ANKLE"
          ]
        },
        {
          "id": "holding",
          "enter": {
            "kind": "timeInPhase",
            "op": ">=",
            "valueMs": 1000
          },
          "timeoutMs": 45000,
          "timeoutCode": "MAX_HOLD_REACHED",
          "measureHere": true,
          "abort": {
            "kind": "any",
            "of": [
              {
                "kind": "metric",
                "metric": "plank_hip_deviation",
                "op": ">",
                "value": 0.22
              },
              {
                "kind": "confidence",
                "op": "<",
                "value": 0.6
              }
            ]
          },
          "abortCode": "FORM_BREAK",
          "_note": "Abort burada BAŞARISIZLIK DEĞİL, ölçümün bittiği andır: süre form bozulana kadar sayılır. Kullanıcıya 'başaramadın' denmez."
        },
        {
          "id": "complete",
          "enter": {
            "kind": "timeInPhase",
            "op": ">=",
            "valueMs": 45000
          },
          "isTerminal": true
        }
      ]
    },
