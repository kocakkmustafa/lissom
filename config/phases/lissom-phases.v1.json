{
  "schemaVersion": 1,
  "id": "lissom.assessment.phases",
  "version": "1.2.0",
  "metricSet": "lissom.assessment.metrics@1.0.0",
  "testSet": "lissom.assessment.battery@1.0.0",
  "_notes": [
    "Test faz tanımları — motion_core `PhaseDefinition` üretimi için veri.",
    "Faz MANTIĞI çekirdekte (PhaseCondition = tip-güvenli Dart fonksiyonu); bu dosya faz SIRASINI, EŞİKLERİNİ ve zamanlamalarını taşır. 'Yeni test = config' iddiası burada geçerli: yeni bir ROM testi eklemek kod değil kayıt ister.",
    "Zorunlu değişmez: her test dizisinde tam bir terminal faz vardır ve her terminal olmayan fazın timeoutMs değeri bulunur. Timeout'suz faz, çıkış koşulunu kaçırdığında sonsuza park eder ve bu dışarıdan 'kullanıcı hareketsiz' gibi görünür (çekirdek dokümantasyonundaki uyarı).",
    "Eşikler G1-a metodolojisiyle sentetik iskelette türetildi; gerçek fixture kalibrasyonu G1-b'de yapılacak ve bu dosyanın sürümü yükseltilecek.",
    "FAZ SÜRÜCÜSÜ ≠ ÖLÇÜM METRİĞİ (L-055). Faz geçişlerini süren metrik, hareketin KENDİSİNİ tarif etmeli; ölçtüğümüz kusuru değil. overhead_squat'ta ölçüm trunk_lean'dir ama faz sürücüsü knee_flexion'dır: gövde eğimi bir HATA ölçüsüdür ve iyi performansta ~0 kalır — faz geçişini ona bağlamak, mükemmel yapan kullanıcıda 'descending' fazının HİÇ tetiklenmemesi demek olurdu. Aynı ayrım hip_hinge'de tersine döner: orada öne eğilme hareketin kendisidir, o yüzden trunk_lean hem sürücü hem ölçümdür.",
    "1.2.0 (M-F-71 / L-135): ölçüm-sınıfı testlerde peak_hold.enter ROM-eşiği OLAMAZ — overhead_reach/ankle_dorsiflexion/lateral_bend'in mutlak-değer şartı kaldırıldı, yalnız hız (delta) koşulu kaldı (deep_squat.bottom / hamstring_reach.peak_hold ile aynı desen). Eski 60/15/15 değerleri skor-bandı tabanı rolüne taşındı (bkz. lissom-assessment.v1.json movementPresence), giriş kapısı değil. Ayrıca: her terminal-olmayan faza timeoutCode eklendi (L-146/M-F-71 nokta 4) — plain timeout de artık isimli bir sonuç üretir, sessizce düşmez."
  ],
  "conditionGrammar": {
    "_note": "Çekirdeğin yorumlayacağı koşul dili. Her koşul saf fonksiyondur — kendi durumunu tutmaz.",
    "forms": [
      {
        "kind": "metric",
        "fields": [
          "metric",
          "op",
          "value"
        ],
        "example": {
          "kind": "metric",
          "metric": "shoulder_flexion_{side}",
          "op": ">=",
          "value": 140
        }
      },
      {
        "kind": "delta",
        "fields": [
          "metric",
          "op",
          "valuePerSecond"
        ],
        "note": "SANİYE başına değişim — kare-başına eşik hem hareket genliğine hem cihaz fps'ine duyarlıydı (L-069/L-070)",
        "example": {
          "kind": "delta",
          "metric": "knee_flexion_right",
          "op": "<",
          "valuePerSecond": -30.0
        }
      },
      {
        "kind": "timeInPhase",
        "fields": [
          "op",
          "valueMs"
        ],
        "example": {
          "kind": "timeInPhase",
          "op": ">=",
          "valueMs": 2000
        }
      },
      {
        "kind": "confidence",
        "fields": [
          "op",
          "value"
        ],
        "note": "kare kalitesi kapısı",
        "example": {
          "kind": "confidence",
          "op": "<",
          "value": 0.6
        }
      },
      {
        "kind": "all",
        "fields": [
          "of"
        ],
        "note": "VE"
      },
      {
        "kind": "any",
        "fields": [
          "of"
        ],
        "note": "VEYA"
      }
    ],
    "ops": [
      ">",
      ">=",
      "<",
      "<=",
      "==",
      "!="
    ]
  },
  "patterns": {
    "_note": "Üç çekirdek desen; 12 testin tamamı bunlardan birine oturur.",
    "rom_sweep": "READY → MOVING → PEAK_HOLD → RETURNING → COMPLETE. Ölçüm PEAK_HOLD'da alınır. (overhead_reach, hamstring_reach, lateral_bend, ankle_dorsiflexion, thoracic_rotation, aslr)",
    "descend_return": "READY → DESCENDING → BOTTOM → ASCENDING → COMPLETE. Ölçüm BOTTOM'da. (deep_squat, overhead_squat, forward_lunge, hip_hinge)",
    "timed_hold": "READY → HOLDING → COMPLETE|FAILED. Ölçüm süre + form bozulma anı. (single_leg_balance, plank_hold)"
  },
  "tests": [
    {
      "testId": "overhead_reach",
      "pattern": "rom_sweep",
      "perSide": true,
      "phases": [
        {
          "id": "ready",
          "enter": {
            "kind": "metric",
            "metric": "shoulder_flexion_{side}",
            "op": "<",
            "value": 40
          },
          "minDurationMs": 500,
          "timeoutMs": 30000,
          "timeoutCode": "SETUP_TIMEOUT",
          "requiredLandmarks": [
            "{SIDE}_SHOULDER",
            "{SIDE}_ELBOW",
            "MID_HIP"
          ]
        },
        {
          "id": "raising",
          "enter": {
            "kind": "delta",
            "metric": "shoulder_flexion_{side}",
            "op": ">",
            "valuePerSecond": 30.0
          },
          "timeoutMs": 8000,
          "timeoutCode": "MOVEMENT_NOT_DETECTED",
          "abort": {
            "kind": "confidence",
            "op": "<",
            "value": 0.6
          },
          "abortCode": "LOW_CONFIDENCE"
        },
        {
          "id": "peak_hold",
          "enter": {
            "kind": "delta",
            "metric": "shoulder_flexion_{side}",
            "op": "<",
            "valuePerSecond": 15.0
          },
          "minDurationMs": 1500,
          "timeoutMs": 6000,
          "timeoutCode": "HOLD_TIMEOUT_MEASURED",
          "measureHere": true,
          "abort": {
            "kind": "metric",
            "metric": "elbow_extension_{side}",
            "op": "<",
            "value": 150
          },
          "abortCode": "BENT_ELBOW"
        },
        {
          "id": "returning",
          "enter": {
            "kind": "delta",
            "metric": "shoulder_flexion_{side}",
            "op": "<",
            "valuePerSecond": -30.0
          },
          "timeoutMs": 8000,
          "timeoutCode": "RETURN_TIMEOUT"
        },
        {
          "id": "complete",
          "enter": {
            "kind": "metric",
            "metric": "shoulder_flexion_{side}",
            "op": "<",
            "value": 45
          },
          "isTerminal": true
        }
      ]
    },
    {
      "testId": "deep_squat",
